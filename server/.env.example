# VEXTRALOOM Server Environment Variables Template
# Copy this file to .env and provide your local credentials.
# NEVER commit .env to source control.

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Target Database: vextraloom
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vextraloom?retryWrites=true&w=majority

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Optional: DNS fallback resolvers (comma-separated, used if local ISP DNS fails on SRV queries)
# DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
CLIENT_ORIGIN=


PASSWORD_RESET_EXPIRES_MINUTES=15
VITE_GOOGLE_CLIENT_ID=
