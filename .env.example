# VEXTRALOOM Environment Configuration Template
# Copy this file to .env or server/.env and fill in real values locally.
# DO NOT commit real secrets or credentials to Git.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Configuration
# Target database: vextraloom
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vextraloom?retryWrites=true&w=majority

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables (prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional: DNS fallback resolvers (comma-separated, used if local ISP DNS fails on SRV queries)
# DNS_SERVERS=8.8.8.8,1.1.1.1
